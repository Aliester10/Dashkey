{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DashKey",
  "version": "0.1.0",
  "identifier": "com.dashkey.host",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DashKey Host",
        "width": 1200,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png"
    ],
    "category": "Utility",
    "shortDescription": "Dashboard control panel DashKey Host"
  }
}
